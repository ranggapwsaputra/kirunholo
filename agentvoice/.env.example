# =============================================================================
# KIRUN AgentVoice — Environment Variables
# =============================================================================
# Salin file ini sebagai .env dan isi nilainya.
# Port Python voice agent WebSocket: 7788

# --- Gemini (Google AI Studio) ---
# WAJIB: Dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model untuk text response (generateContent REST API)
GEMINI_MODEL=gemini-2.5-flash

# Model untuk Native Audio Dialog (Gemini Live API — WebSocket streaming)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# --- OpenRouter (Opsional fallback) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash:free

# --- Voice Agent Config ---
WS_PORT=7788
WS_HOST=127.0.0.1
